<div class="container">
  <h1><%= pagina.titulo %></h1>

  <% if (pagina.texto) { %>
    <p class="texto-corrido"><%= pagina.texto %></p>
  <% } %>

  <% if (bairros) { %>
    <%- include('../parciais/busca-bairro', { bairros: bairros, conselhos: conselhos }) %>
  <% } %>

  <%- include('../parciais/bloco-emergencia', { conselhos: conselhos, emergencia: emergencia }) %>

  <%- include('../parciais/grade-atalhos', { atalhos: atalhos }) %>

  <% if (pagina.secoes) { %>
    <%- include('../parciais/secoes', { secoes: pagina.secoes, conselhos: conselhos }) %>
  <% } %>
</div>