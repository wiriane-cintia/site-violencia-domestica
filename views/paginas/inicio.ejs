<div class="faixa faixa--topo">
  <div class="container topo-linha">

    <div class="topo-linha__titulo">
      <% if (pagina.texto) { %>
        <details class="intro">
          <summary class="intro__resumo">
            <h1 class="intro__titulo"><%= pagina.titulo %></h1>
            <span class="intro__mais" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
            <span class="apenas-leitor">Abrir explicação sobre este site</span>
          </summary>
          <p class="intro__texto texto-corrido"><%= pagina.texto %></p>
        </details>
      <% } else { %>
        <h1 class="intro__titulo"><%= pagina.titulo %></h1>
      <% } %>
    </div>

    <% if (bairros) { %>
      <div class="topo-linha__busca">
        <%- include('../parciais/busca-bairro', { bairros: bairros, conselhos: conselhos }) %>
      </div>
    <% } %>

  </div>
</div>

<div class="container">
  <%- include('../parciais/bloco-emergencia', { conselhos: conselhos, emergencia: emergencia }) %>

  <%
    // Secoes que a pagina quer logo depois do bloco de emergencia, antes da
    // grade. E onde entra o "E com o Conselho Tutelar?": quem chega em duvida
    // encontra a resposta antes de precisar escolher uma pagina.
  %>
  <% if (pagina.secoes_topo) { %>
    <%- include('../parciais/secoes', { secoes: pagina.secoes_topo, conselhos: conselhos, rede: rede, situacoes: situacoes }) %>
  <% } %>

  <%- include('../parciais/grade-atalhos', { atalhos: atalhos, navegacao: navegacao, conteudo: conteudo, rotaAtual: rotaAtual }) %>

  <% if (pagina.secoes) { %>
    <%- include('../parciais/secoes', { secoes: pagina.secoes, conselhos: conselhos, rede: rede, situacoes: situacoes }) %>
  <% } %>
</div>