<% secoes.forEach(function (secao) { %>

  <% if (secao.tipo === 'texto') { %>
    <section class="secao texto-corrido">
      <% if (secao.titulo) { %><h2 class="secao__titulo"><%= secao.titulo %></h2><% } %>
      <% secao.paragrafos.forEach(function (paragrafo) { %>
        <p><%= paragrafo %></p>
      <% }); %>
    </section>

  <% } else if (secao.tipo === 'lista') { %>
    <section class="secao texto-corrido">
      <% if (secao.titulo) { %><h2 class="secao__titulo"><%= secao.titulo %></h2><% } %>
      <ul class="secao__lista">
        <% secao.itens.forEach(function (item) { %>
          <li><%= item %></li>
        <% }); %>
      </ul>
    </section>

  <% } else if (secao.tipo === 'passos') { %>
    <section class="secao texto-corrido">
      <% if (secao.titulo) { %><h2 class="secao__titulo"><%= secao.titulo %></h2><% } %>
      <ol class="secao__passos">
        <% secao.itens.forEach(function (item) { %>
          <li>
            <% if (typeof item === 'string') { %>
              <%= item %>
            <% } else { %>
              <% if (item.titulo) { %><strong class="secao__passo-titulo"><%= item.titulo %></strong><% } %>
              <span><%= item.texto %></span>
            <% } %>
          </li>
        <% }); %>
      </ol>
    </section>

  <% } else if (secao.tipo === 'aviso') { %>
    <div class="aviso secao">
      <% if (secao.titulo) { %><h2 class="secao__titulo"><%= secao.titulo %></h2><% } %>
      <p><%= secao.texto %></p>
    </div>

  <% } else if (secao.tipo === 'destaque') { %>
    <div class="destaque secao">
      <% if (secao.titulo) { %><h2 class="secao__titulo"><%= secao.titulo %></h2><% } %>
      <p><%= secao.texto %></p>
    </div>

  <% } else if (secao.tipo === 'perguntas') { %>
    <section class="secao texto-corrido">
      <% if (secao.titulo) { %><h2 class="secao__titulo"><%= secao.titulo %></h2><% } %>
      <% secao.itens.forEach(function (item) { %>
        <details class="pergunta">
          <summary class="pergunta__titulo"><%= item.pergunta %></summary>
          <p class="pergunta__resposta"><%= item.resposta %></p>
        </details>
      <% }); %>
    </section>

  <% } else if (secao.tipo === 'rede') { %>
    <section class="secao secao-rede">
      <% if (secao.titulo) { %><h2 class="secao__titulo"><%= secao.titulo %></h2><% } %>
      <% rede.grupos.forEach(function (grupo) { %>
        <div class="secao-rede__grupo">
          <h3 class="secao-rede__grupo-titulo"><%= grupo.titulo %></h3>
          <% if (grupo.descricao) { %><p class="secao-rede__grupo-texto"><%= grupo.descricao %></p><% } %>
          <ul class="secao-rede__lista">
            <% grupo.itens.forEach(function (item) { %>
              <li class="secao-rede__item">
                <p class="secao-rede__nome"><%= item.nome %></p>
                <% if (item.descricao) { %><p class="secao-rede__descricao"><%= item.descricao %></p><% } %>
                <% if (item.endereco) { %>
                  <p class="secao-rede__linha"><%- include('endereco', { texto: item.endereco, mapa: item.endereco_mapa }) %></p>
                <% } %>
                <% if (item.telefone) { %>
                  <p class="secao-rede__linha">
                    <%- include('telefone', { href: 'tel:' + item.telefone_link, rotulo: item.telefone, tipo: 'telefone' }) %>
                  </p>
                <% } %>
                <% if (item.whatsapp_link) { %>
                  <p class="secao-rede__linha">
                    <%- include('telefone', { href: 'https://wa.me/' + item.whatsapp_link + '?text=Ol%C3%A1%2C%20preciso%20de%20ajuda', rotulo: 'Falar no WhatsApp', tipo: 'whatsapp' }) %>
                  </p>
                <% } %>
                <% if (item.horario) { %><p class="secao-rede__linha secao-rede__horario"><%= item.horario %></p><% } %>
                <% if (item.atende) { %><p class="secao-rede__linha secao-rede__atende">Atende: <%= item.atende %></p><% } %>
              </li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
      <p class="secao-rede__fonte">Fonte: <%= rede.fonte %> Atualizado em <%= rede.atualizado_em %>.</p>
    </section>

  <% } else if (secao.tipo === 'telefones') { %>
    <section class="secao secao-contatos">
      <% if (secao.titulo) { %><h2 class="secao__titulo"><%= secao.titulo %></h2><% } %>
      <ul class="secao-contatos__lista">
        <% secao.itens.forEach(function (item) { %>
          <li><%- include('telefone', { href: item.href, rotulo: item.rotulo, tipo: item.tipo || 'telefone' }) %></li>
        <% }); %>
      </ul>
    </section>

  <% } else if (secao.tipo === 'contatos') { %>
    <section class="secao secao-contatos">
      <% if (secao.titulo) { %><h2 class="secao__titulo"><%= secao.titulo %></h2><% } %>
      <div class="secao-contatos__grade">
        <% [conselhos.conselho_1, conselhos.conselho_2].forEach(function (conselho) { %>
          <div class="secao-contatos__item">
            <h3 class="secao-contatos__nome"><%= conselho.nome %></h3>
            <ul class="secao-contatos__lista">
              <% conselho.telefones.forEach(function (tel, i) { %>
                <li><%- include('telefone', { href: 'tel:' + conselho.telefones_link[i], rotulo: tel, tipo: 'telefone' }) %></li>
              <% }); %>
              <li><%- include('telefone', { href: 'https://wa.me/' + conselho.plantao_24h_link + '?text=Ol%C3%A1%2C%20preciso%20de%20ajuda', rotulo: 'Plantão 24h — ' + conselho.plantao_24h, tipo: 'whatsapp' }) %></li>
              <% if (conselho.endereco) { %>
                <li><%- include('endereco', { texto: conselho.endereco, mapa: conselho.endereco_mapa }) %></li>
              <% } %>
            </ul>
          </div>
        <% }); %>
      </div>
    </section>

  <% } %>

<% }); %>